<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="О нас — Garant Store" Width="680" Height="760" MinWidth="680" MinHeight="760" MaxWidth="680" MaxHeight="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#111512" Foreground="#EEF2EE" FontFamily="Segoe UI" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#DCE4DD"/><Setter Property="Background" Value="#232A25"/><Setter Property="BorderBrush" Value="#343C36"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="shell" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shell" Property="Background" Value="#2A332C"/><Setter TargetName="shell" Property="BorderBrush" Value="#48534A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="shell" Property="BorderBrush" Value="#91D5A5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#91D5A5"/><Setter Property="BorderBrush" Value="#91D5A5"/><Setter Property="Foreground" Value="#142019"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,7"/><Setter Property="MinWidth" Value="88"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
   <Image x:Name="BrandMark" Width="58" Height="58" Stretch="Uniform" Margin="0,0,14,0"/>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="Garant Store" FontSize="24" FontWeight="Medium"/><TextBlock Text="О нас и поддержка" FontSize="13" Foreground="#ADB7AF" Margin="0,4,0,0"/></StackPanel>
  </StackPanel>
  <Border Grid.Row="2" Background="#1B211D" BorderBrush="#303832" BorderThickness="1" CornerRadius="12" Padding="16">
   <StackPanel><TextBlock Text="Ибрагим" FontSize="18" FontWeight="Medium"/><TextBlock Text="Автор проектов Garant Store · мастер по ремонту телефонов, компьютеров и ноутбуков" TextWrapping="Wrap" FontSize="12" Foreground="#ADB7AF" Margin="0,6,0,0"/><TextBlock Text="ЧР, г. Грозный, магазин «Гарант»" FontSize="12" Foreground="#89938B" Margin="0,8,0,0"/></StackPanel>
  </Border>
  <StackPanel Grid.Row="4"><TextBlock Text="Связь" FontSize="12" Foreground="#89938B" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ContactInstagram" Content="Instagram · @master.vu95" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center"/><Button x:Name="ContactWhatsApp" Grid.Column="2" Content="WhatsApp · +7(928)745-42-49" HorizontalContentAlignment="Center"/><Button x:Name="ContactEmail" Grid.Column="4" Content="Почта · g-garant95@mail.ru" HorizontalContentAlignment="Center"/></Grid></StackPanel>
  <Border Grid.Row="6" Background="#1B211D" BorderBrush="#303832" BorderThickness="1" CornerRadius="12" Padding="16">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="Добровольная поддержка" FontSize="16" FontWeight="Medium"/><TextBlock Text="Если хотите поддержать мои проекты, вот мои реквизиты:" FontSize="12" Foreground="#ADB7AF" Margin="0,5,0,12"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="СБП по номеру" FontSize="11" Foreground="#89938B"/><TextBlock Text="+7(928)745-42-49" FontSize="14" FontWeight="Medium" Margin="0,3,0,0"/><TextBlock Text="Сбербанк · Т-Банк · ВТБ · Ozon · Альфа-банк" FontSize="10" Foreground="#89938B" Margin="0,3,0,0"/></StackPanel><Button x:Name="CopySbp" Grid.Column="1" Content="Копировать" Style="{StaticResource CopyButton}"/></Grid>
    <StackPanel Grid.Row="3" Margin="0,1,0,0"><TextBlock Text="Получатель" FontSize="11" Foreground="#89938B"/><TextBlock Text="Ибрагим Г-А-Насерович" FontSize="13" FontWeight="Medium" Margin="0,3,0,0"/></StackPanel>
    <TextBlock x:Name="CopyFeedback" Grid.Row="4" Text="Перевод добровольный и помогает развитию проектов" FontSize="10" Foreground="#91D5A5" Margin="0,12,0,0"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="7" Margin="0,12,0,0"><TextBlock x:Name="BuildIdentity" Text="Garant Store Next · 0.11.0 Preview" FontSize="10" Foreground="#89938B"/></StackPanel>
 </Grid>
</Window>

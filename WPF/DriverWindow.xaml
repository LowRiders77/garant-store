<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Драйверы — Garant Store" Width="1080" Height="760" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#111512" Foreground="#EEF2EE" FontFamily="Segoe UI" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#DCE4DD"/><Setter Property="Background" Value="#232A25"/><Setter Property="BorderBrush" Value="#343C36"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2A332C"/><Setter TargetName="b" Property="BorderBrush" Value="#48534A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#91D5A5"/><Setter Property="BorderBrush" Value="#91D5A5"/><Setter Property="Foreground" Value="#142019"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="#465149"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="#91D5A5"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="#91D5A5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE4DD"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#A9DDB5"/></Trigger></Style.Triggers></Style>
  <DataTemplate x:Key="Device"><Border Background="#1B211D" BorderBrush="#303832" BorderThickness="1" CornerRadius="9" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox AutomationProperties.AutomationId="DriverRowCheckbox" IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding canSelect}" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding name}" Foreground="#EEF2EE" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{Binding hwid}" FontFamily="Consolas" Foreground="#B0BBB2" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding reason}" Foreground="#AAB5AC" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="2" Background="#26392B" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding KindText}" Foreground="#A9DDB5" FontSize="10"/></Border></Grid></Border></DataTemplate>
  <GroupStyle x:Key="DriverCategoryGroup"><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#91D5A5" FontWeight="SemiBold" FontSize="12" Margin="2,9,0,5"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,18"><Button x:Name="DriverClose" DockPanel.Dock="Right" Content="Закрыть" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel><TextBlock x:Name="DriverHeading" Text="Драйверы" FontSize="27" FontWeight="Medium"/><TextBlock Text="Сканирование устройств, обновлений и необходимых компонентов Windows" Foreground="#ADB7AF" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DriverDeviceProfile" Foreground="#91D5A5" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="#1B211D" BorderBrush="#303832" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DriverState" Text="Движок не запущен" FontWeight="Medium"/><TextBlock x:Name="DriverDetail" Text="Нажмите «Сканировать», чтобы проверить систему" Foreground="#89938B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><ProgressBar x:Name="DriverProgress" Grid.Column="1" Height="5" VerticalAlignment="Center" Foreground="#91D5A5" Background="#343C36" BorderThickness="0"/></Grid></Border>
  <Grid Grid.Row="2" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="DriverScan" Content="Сканировать" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="DriverNetwork" Content="Восстановить сеть" Margin="0,0,8,0"/><Button x:Name="DriverLocal" Content="Установить из папки" Margin="0,0,8,0"/><Button x:Name="DriverCancel" Content="Остановить" IsEnabled="False"/></StackPanel><StackPanel x:Name="DriverSelectionActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed"><Button x:Name="DriverInstall" Content="Установить / обновить" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="DriverDownload" Content="Только скачать" Margin="0,0,8,0"/><Button x:Name="DriverSource" Content="Источник драйвера"/></StackPanel></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DriverLogSpacer" Width="0"/><ColumnDefinition x:Name="DriverLogColumn" Width="0"/></Grid.ColumnDefinitions><Border Background="#151A16" BorderBrush="#303832" BorderThickness="1" CornerRadius="12" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><WrapPanel><TextBlock x:Name="DriverDeviceCount" Text="Результаты сканирования" Foreground="#ADB7AF" VerticalAlignment="Center" Margin="0,0,10,6"/><Button x:Name="DriverSelectAll" Content="Выбрать доступные" Padding="8,5" Margin="0,0,7,6" AutomationProperties.AutomationId="DriverSelectAvailable"/><Button x:Name="DriverViewAll" AutomationProperties.AutomationId="DriverViewInstalledToggle" Content="Все установленные драйверы" Padding="8,5" Margin="0,0,7,6"/><Button x:Name="DriverViewComponents" AutomationProperties.AutomationId="DriverViewComponentsToggle" Content="Компоненты Windows" Padding="8,5" Margin="0,0,7,6"/><Button x:Name="DriverToggleLog" AutomationProperties.AutomationId="DriverLogToggle" Content="Показать журнал" Padding="8,5" Margin="0,0,0,6"/></WrapPanel><TextBlock x:Name="DriverEmptyMessage" Text="" Foreground="#AAB5AC" FontSize="11" TextWrapping="Wrap"/></StackPanel><ListBox x:Name="DriverDevices" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource Device}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.GroupStyle><StaticResource ResourceKey="DriverCategoryGroup"/></ListBox.GroupStyle></ListBox></DockPanel></Border><Border x:Name="DriverLogPanel" Grid.Column="2" Visibility="Collapsed" Background="#151A16" BorderBrush="#303832" BorderThickness="1" CornerRadius="12" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Журнал операции" Foreground="#ADB7AF" VerticalAlignment="Center"/><Button x:Name="DriverOpenFolder" Content="Папка драйверов" Padding="8,5" Margin="12,0,0,0"/></StackPanel><TextBox x:Name="DriverLog" Background="#101410" Foreground="#A9DDB5" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Border></Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="DriverHint" Text="Отметьте найденные элементы, чтобы применить действие только к выбранному." Foreground="#89938B" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/><WrapPanel Margin="0,7,0,0"><Button x:Name="DriverRestore" Content="Точка восстановления" Padding="9,6" Margin="0,0,7,0"/><Button x:Name="DriverWuRepair" Content="Включить Windows Update" Padding="9,6" Margin="0,0,7,0"/><Button x:Name="DriverDiagnostics" Content="Скачать диагностику" Padding="9,6"/></WrapPanel></StackPanel>
 </Grid>
</Window>


